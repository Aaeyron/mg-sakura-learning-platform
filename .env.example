# Copy this file to .env.local and fill in the real values.
# .env.local is git-ignored — never commit real keys.

# Supabase → Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (starts with sb_publishable_)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY secret key — full access that bypasses all security rules.
# Used only in server code (Server Actions) to create student accounts.
# NEVER give it a NEXT_PUBLIC_ name and NEVER import it in a client component.
# Supabase → Project Settings → API Keys → Secret keys (starts with sb_secret_)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
